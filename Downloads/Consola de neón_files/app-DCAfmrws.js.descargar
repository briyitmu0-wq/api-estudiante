  query ListPaginatedWorkspaces($first: Int!, $after: String, $ignoreRegionalFailures: Boolean!)
  @component(name: "IdentityMgmt.InternalServices") {
    listGraphqlCustomerWorkspaces(
      returnIndirectlyAssignedWorkspaces: true
      workspaceStatusFilters: [RUNNING]
      ignoreRegionalFailures: $ignoreRegionalFailures
      first: $first
      after: $after
    ) {
      workspaces {
        awsRegion
        azureLocation
        deploymentName
        gcpRegion
        isComplianceMode
        needsConfirmation
        useRegionalUrl
        workspaceId
        workspaceName
        workspaceStatus
        __typename
      }
      pageInfo {
        hasNextPage
        endCursor
        __typename
      }
      hasRegionalFailures @include(if: $ignoreRegionalFailures)
      __typename
